# Copy to .env and fill in. Never commit .env.
# From https://dev.twitch.tv/console/apps (see README "Register the Twitch application").
TWITCH_CLIENT_ID=your-client-id-here
TWITCH_CLIENT_SECRET=your-client-secret-here
# Must match the OAuth Redirect URL registered in the Twitch console exactly.
# Default when empty: http://localhost:3977/auth/callback
TWITCH_REDIRECT_URI=

# Local server (loopback only).
HH_PORT=3977
HH_HOST=127.0.0.1
# Where the database, tokens and dashboard token live (keep this folder private).
HH_DATA_DIR=data
# Use your own art: point this at a folder with a manifest.json (see docs/ASSETS.md).
# HH_ASSET_PACK=assets-custom
