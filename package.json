{
  "name": "hulks-hangout",
  "version": "0.1.0",
  "private": true,
  "description": "Chat-controlled Hulk companion for Twitch streams, shown in OBS as a browser source.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --no-warnings=ExperimentalWarning dist/server/server/main.js",
    "demo": "npm run build && node --no-warnings=ExperimentalWarning dist/server/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:smoke": "node --no-warnings=ExperimentalWarning scripts/smoke.mjs",
    "test:load": "node --no-warnings=ExperimentalWarning scripts/load.mjs",
    "assets": "node scripts/gen-placeholder-assets.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
